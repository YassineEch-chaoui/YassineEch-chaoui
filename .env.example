# Environment Variables for Streamlit Portfolio Application
# Copy this file to .env and fill in your actual values

# GitHub Configuration
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_USERNAME=YassineEch-chaoui

# Email Service Configuration (for contact form)
EMAIL_SERVICE_KEY=your_email_service_api_key_here
EMAIL_FROM=noreply@yourdomain.com
EMAIL_TO=your_email@yourdomain.com

# Application Configuration
STREAMLIT_ENV=production
DEBUG_MODE=false

# Analytics (optional)
GOOGLE_ANALYTICS_ID=your_ga_tracking_id_here

# Social Media Links (optional)
LINKEDIN_URL=https://linkedin.com/in/your-profile
TWITTER_URL=https://twitter.com/your-handle
DISCORD_ID=your-discord-id

# Portfolio Configuration
PORTFOLIO_TITLE=Your Name - Portfolio
PORTFOLIO_DESCRIPTION=Software Developer & Tech Enthusiast

# Security
SECRET_KEY=your_secret_key_for_sessions_here

# Performance
CACHE_TTL=3600
MAX_UPLOAD_SIZE=10485760

# Feature Flags
ENABLE_CONTACT_FORM=true
ENABLE_ANALYTICS=false
ENABLE_DARK_MODE=true
ENABLE_ANIMATIONS=true